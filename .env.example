# Copy to .env for local use. NAMES ONLY � never commit values.
# Rotate any Alpaca key that was pasted in chat before production. See README.

# --- app ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
LOG_LEVEL=INFO
SENTRY_DSN=

# --- auth ---
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
OTP_TTL_SECONDS=90
AUTOFILL_2FA=true

# --- database ---
DATABASE_URL=postgresql+asyncpg://apex:apex@localhost:5432/apex
REDIS_URL=redis://localhost:6379/0

# --- alpaca (required for live options chain; leave empty for honest empty-state) ---
# Rotate any key that was pasted in chat before production. Never commit real values.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# paper | live  � selects official Alpaca base URL server-side
ALPACA_TRADING_MODE=paper
# Optional overrides. If empty, derived from ALPACA_TRADING_MODE.
ALPACA_BROKER_BASE_URL=
ALPACA_DATA_BASE_URL=
# Internal Black-Scholes ladder � OFF by default. Set true only for offline demos.
ALLOW_OPTIONS_SIMULATOR=false

# --- snaptrade (read-only brokerage connection) ---
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_ENV=sandbox
ENCRYPTION_KEY=
API_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# --- frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_SPLASH_DURATION_MS=7200

# --- snaptrade (read-only brokerage connection) ---
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_ENV=sandbox
ENCRYPTION_KEY=
