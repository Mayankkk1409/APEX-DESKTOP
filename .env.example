# Copy to .env for local use. NAMES ONLY � never commit values.
# Rotate any Alpaca key that was pasted in chat before production. See README.

# --- app ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
LOG_LEVEL=INFO
SENTRY_DSN=

# --- auth ---
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
OTP_TTL_SECONDS=90
AUTOFILL_2FA=true

# --- database ---
DATABASE_URL=postgresql+asyncpg://apex:apex@localhost:5432/apex
REDIS_URL=redis://localhost:6379/0

# --- alpaca (required for live options chain; leave empty for honest empty-state) ---
# Rotate any key that was pasted in chat before production. Never commit real values.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# paper | live  � selects official Alpaca base URL server-side
ALPACA_TRADING_MODE=paper
# Optional overrides. If empty, derived from ALPACA_TRADING_MODE.
# Host only — do not append /v2 (the client adds /v2/... paths).
ALPACA_BROKER_BASE_URL=
ALPACA_DATA_BASE_URL=
# Internal Black-Scholes ladder � OFF by default. Set true only for offline demos.
ALLOW_OPTIONS_SIMULATOR=false

# --- snaptrade (read-only brokerage connection) ---
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_ENV=sandbox
# Host only — do not append /api/v1 (the SDK adds unversioned paths).
SNAPTRADE_BASE_URL=
ENCRYPTION_KEY=
API_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# --- frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_SPLASH_DURATION_MS=7200

# --- strategy gates (defaults match the engine; override only to retune) ---
# abs_per_share: daily theta < 0.05 per share, and |delta|/|theta| > 10
# pct_of_premium: abs(theta) / premium < THETA_MAX_PCT_PER_DAY; the delta/theta ratio is skipped
THETA_FILTER_MODE=pct_of_premium
THETA_MAX_PCT_PER_DAY=0.015
# Entry must stay above exit so a score near one line does not flip a position.
ENTRY_COMPOSITE_MIN=45
EXIT_COMPOSITE_MIN=40
# Front-week IV minus back-week IV, in volatility points (35 vs 30 is 5).
MIN_IV_INVERSION_PTS=5

# Change 11 — APEX Benchmark Greeks Strategy Rule 1 (buy)
RULE1_DELTA_MIN=0.55
RULE1_DTE_MIN=30
RULE1_DTE_MAX=90
RULE1_THETA_PCT_PER_DAY=0.010
RULE1_DELTA_THETA_RATIO_MIN=10
RULE1_SPREAD_MAX=0.08
RULE1_SENTIMENT_BULL_MIN=65
RULE1_SENTIMENT_BEAR_MAX=40

# Change 11 — APEX Benchmark Greeks Strategy Rule 2 (defined-risk sell)
RULE2_IV_RANK_MIN=50
RULE2_RSI_MIN=40
RULE2_RSI_MAX=60
RULE2_SHORT_DELTA_MAX=0.20
RULE2_DTE_MIN=30
RULE2_DTE_MAX=45
RULE2_WING_WIDTH_PCT=0.03
RULE2_SPREAD_MAX=0.10
RULE2_CREDIT_MIN_PCT_OF_WIDTH=0.20

# Change 11 — Gamma Trampoline
GAMMA_EARNINGS_DAYS_MIN=5
GAMMA_EARNINGS_DAYS_MAX=10
GAMMA_FRONT_IV_RANK_MIN=70
GAMMA_FRONT_BACK_IV_RATIO_MIN=1.25
GAMMA_HISTORY_HITS_MIN=5
GAMMA_HISTORY_LOOKBACK=8
GAMMA_ADV_MIN=5000000
GAMMA_OPEN_INTEREST_MIN=1000
GAMMA_SPREAD_MAX=0.08
GAMMA_BACK_WEEK_DAYS=14
GAMMA_BACK_WEEK_TOLERANCE_DAYS=4

# --- snaptrade (read-only brokerage connection) ---
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_ENV=sandbox
ENCRYPTION_KEY=
